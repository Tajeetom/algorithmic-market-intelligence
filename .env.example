# ─────────────────────────────────────────────────────────
# Algorithmic Market Intelligence Platform — Configuration
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────

AMP_SIMULATION_MODE=true
AMP_INITIAL_CAPITAL=10000
AMP_POLL_INTERVAL=5.0
AMP_LOG_LEVEL=INFO

# Ingestion
AMP_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
AMP_SOLANA_RPC_API_KEY=
AMP_JUPITER_API_KEY=
AMP_CMC_API_KEY=
AMP_DEX_API_KEY=

# Feature Engineering
AMP_FEATURE_WINDOW=50
AMP_RSI_PERIOD=14

# Inference
AMP_SIGNAL_THRESHOLD=0.6
AMP_MODEL_PATH=models/artifacts/model.onnx

# Execution
AMP_JUPITER_LIVE_ENABLED=false
AMP_ORDER_SIZE_SOL=0.02
AMP_BUY_SLIPPAGE_BPS=500

# Risk
AMP_MAX_POSITION_PCT=0.10
AMP_MAX_DRAWDOWN_PCT=0.15
AMP_MAX_OPEN_POSITIONS=5
AMP_SELL_PROFIT_THRESHOLD_PCT=10.0
AMP_SELL_STOP_LOSS_PCT=-5.0
